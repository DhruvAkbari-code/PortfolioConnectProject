@* Purpose: Renders the watchlist table with live prices from Yahoo Finance *@

@model List<FinalSem2Project.Models.Watchlist>
@{
    ViewData["Title"] = "Watchlist";
    var quotes = ViewBag.LiveQuotes as Dictionary<string, FinalSem2Project.Models.LiveQuote>;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;padding:12px 16px;
        background:rgba(0,160,90,0.1);border:1px solid rgba(0,160,90,0.3);
        border-radius:8px;color:var(--green);font-size:13px">
        <i class="fas fa-circle-check"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px;padding:12px 16px;
        background:rgba(200,40,40,0.08);border:1px solid rgba(200,40,40,0.25);
        border-radius:8px;color:var(--red);font-size:13px">
        <i class="fas fa-circle-exclamation"></i> @TempData["ErrorMessage"]
    </div>
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
    <p style="color:var(--text-secondary);font-size:13px">Live prices via Yahoo Finance, updated on each page load.</p>
    <button class="btn btn-primary" onclick="document.getElementById('addModal').classList.add('open')">
        <i class="fas fa-plus"></i> Add Stock
    </button>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title">
            <i class="fas fa-heart" style="color:var(--red);margin-right:8px"></i>
            Watchlist (@(Model?.Count ?? 0))
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>Name</th>
                    <th>Exchange</th>
                    <th>Price When Added</th>
                    <th>Live Price</th>
                    <th>Day Change</th>
                    <th>Day Change %</th>
                    <th>Added On</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var quote  = quotes?.GetValueOrDefault(item.StockSymbol);
                    var price  = quote?.Price;
                    var change = quote?.Change ?? 0;
                    var pct    = quote?.PctChange ?? 0;
                    var up     = change >= 0;
                    var color  = up ? "var(--green)" : "var(--red)";
                    var pillBg = up ? "rgba(0,160,90,0.12)" : "rgba(200,40,40,0.10)";
                    var arrow  = up ? "▲" : "▼";

                    <tr>
                        <td>
                            <div class="symbol-cell">
                                <div class="symbol-icon">
                                    @(item.StockSymbol.Length >= 2 ? item.StockSymbol[..2] : item.StockSymbol)
                                </div>
                                <a href="/Stock/@item.StockSymbol"
                                   style="color:inherit;text-decoration:none;font-weight:500">
                                    @item.StockSymbol
                                </a>
                            </div>
                        </td>
                        <td>@item.StockName</td>
                        <td><span class="badge badge-blue">@item.Exchange</span></td>
                        <td>@(item.PriceAtAdd.HasValue ? $"₹{item.PriceAtAdd:N2}" : "—")</td>
                        <td style="font-weight:600">
                            @(price.HasValue ? "₹" + price.Value.ToString("N2") : "—")
                        </td>
                        <td style="color:@color;font-weight:500">
                            @if (quote != null)
                            {
                                @($"{arrow} ₹{Math.Abs(change):F2}")
                            }
                            else
                            {
                                <span style="color:var(--text-secondary)">—</span>
                            }
                        </td>
                        <td>
                            @if (quote != null)
                            {
                                <span style="background:@pillBg;color:@color;
                                             padding:3px 10px;border-radius:20px;
                                             font-size:12px;font-weight:600">
                                    @($"{arrow} {Math.Abs(pct):F2}%")
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--text-secondary)">—</span>
                            }
                        </td>
                        <td style="color:var(--text-secondary)">@item.AddedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <form method="post" action="/Watchlist/Remove" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-heart-crack"></i>
            <h4>Your watchlist is empty</h4>
            <p>Add stocks to track their live prices.</p>
            <button class="btn btn-primary" onclick="document.getElementById('addModal').classList.add('open')">
                <i class="fas fa-plus"></i> Add First Stock
            </button>
        </div>
    }
</div>

<!-- Add Modal -->
<div class="modal-overlay" id="addModal">
    <div class="modal-box">
        <div class="modal-title">
            <i class="fas fa-heart" style="color:var(--red);margin-right:8px"></i>Add to Watchlist
        </div>
        <p class="modal-subtitle">Live price will be fetched automatically</p>

        <form method="post" action="/Watchlist/Add">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Stock Symbol</label>
                <input type="text" name="stockSymbol" class="form-input"
                       placeholder="e.g. RELIANCE, TCS, INFY"
                       required style="text-transform:uppercase" />
            </div>
            <div class="form-group">
                <label class="form-label">Stock Name</label>
                <input type="text" name="stockName" class="form-input"
                       placeholder="e.g. Reliance Industries Ltd" />
            </div>
            <div class="form-group">
                <label class="form-label">Exchange</label>
                <select name="exchange" class="form-input">
                    <option value="NSE">NSE</option>
                    <option value="BSE">BSE</option>
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost"
                        onclick="document.getElementById('addModal').classList.remove('open')">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-heart"></i> Add to Watchlist
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('addModal').addEventListener('click', function (e) {
        if (e.target === this) this.classList.remove('open');
    });
</script>