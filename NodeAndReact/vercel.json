{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "express",
    "installCommand": "npm install && npm --prefix server install && npm --prefix client install",
    "buildCommand": "npm --prefix client run build",
    "functions": {
        "index.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/((?!api/|assets/).*)",
            "destination": "/index.html"
        }
    ]
}
